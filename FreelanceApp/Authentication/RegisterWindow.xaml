<Window
    x:Class="FreelanceApp.Authentication.RegisterWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource RegisterWindow_Title}"
    Style="{DynamicResource RegWindowStyle}"
    WindowStartupLocation="CenterScreen"
    MinWidth="600"
    MinHeight="450"
    mc:Ignorable="d"
    Icon="/app.ico">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Margin="20" Style="{DynamicResource BorderMainStyle}">
                <StackPanel
                    Width="300"
                    HorizontalAlignment="Center"
                    Orientation="Vertical">

                    <TextBlock Style="{DynamicResource HeaderText}" Text="{DynamicResource RegisterWindow_Header}" />

                    <TextBlock Style="{DynamicResource RegWindowTextBlock}" Text="{DynamicResource RegisterWindow_Name}" />
                    <TextBox Name="FirstNameBox" Style="{DynamicResource RoundedTextBox}" />

                    <TextBlock Style="{DynamicResource RegWindowTextBlock}" Text="{DynamicResource RegisterWindow_Surname}" />
                    <TextBox Name="LastNameBox" Style="{DynamicResource RoundedTextBox}" />

                    <TextBlock Style="{DynamicResource RegWindowTextBlock}" Text="{DynamicResource RegisterWindow_Email}" />
                    <TextBox Name="EmailBox" Style="{DynamicResource RoundedTextBox}" />

                    <TextBlock Style="{DynamicResource RegWindowTextBlock}" Text="{DynamicResource RegisterWindow_Password}" />
                    <PasswordBox Name="PasswordBox" Style="{DynamicResource RoundedPasswordBox}" />

                    <TextBlock Style="{DynamicResource RegWindowTextBlock}" Text="{DynamicResource RegisterWindow_Phone}" />
                    <TextBox Name="PhoneBox" Style="{DynamicResource RoundedTextBox}" />

                    <TextBlock Style="{DynamicResource RegWindowTextBlock}" Text="{DynamicResource RegisterWindow_Gender}" />
                    <ComboBox
                        Name="GenderBox"
                        SelectedIndex="0"
                        Style="{DynamicResource ProfileComboBoxStyle}"
                        HorizontalAlignment="Center">
                        <ComboBoxItem Content="Male" />
                        <ComboBoxItem Content="Female" />
                        <ComboBoxItem Content="Other" />
                    </ComboBox>

                    <StackPanel
                        Margin="10"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Width="140"
                            Command="{Binding RegisterCommand}"
                            Content="{DynamicResource RegisterWindow_Btn_Register}"
                            Style="{DynamicResource AccentButton}" />
                        <Button
                            Command="{Binding GoBackCommand}"
                            Content="{DynamicResource RegisterWindow_Btn_Back}"
                            Style="{DynamicResource SecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
