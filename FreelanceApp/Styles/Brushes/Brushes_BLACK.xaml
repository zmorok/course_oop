<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  Тёмная тема  -->
    <sys:String x:Key="CurrentTheme">🌙</sys:String>

    <!--  Общие кисти приложения  -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22C55E" Offset="0" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="#111B2E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
    <SolidColorBrush x:Key="InfoBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#38BDF8" />
    <Color x:Key="ShadowColor">#99000000</Color>

    <!--#region  AuthenticationStyles-->
    <SolidColorBrush x:Key="Login_Window_BgColor_Brush" Color="#0C1424" />
    <SolidColorBrush x:Key="Login_BorderMain_BgColor_Brush" Color="#111B2E" />
    <SolidColorBrush x:Key="Login_HeaderText_FgColor_Brush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Login_Button1_BgColor_Brush" Color="#22C55E" />
    <SolidColorBrush x:Key="Login_Button1_FgColor_Brush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Login_Button1_IsMouseOver_BgColor_Brush" Color="#2DD57A" />
    <SolidColorBrush x:Key="Login_Button2_BgColor_Brush" Color="#1F2937" />
    <SolidColorBrush x:Key="Login_Button2_IsMouseOver_BgColor_Brush" Color="#273549" />
    <SolidColorBrush x:Key="Login_TextBox_BgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="Login_TextBox_FgColor_Brush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Login_TextBox_BdColor_Brush" Color="#1F2937" />

    <!--  RegisterWindow  -->
    <SolidColorBrush x:Key="Reg_AccentButton_BgColor_Brush" Color="#38BDF8" />
    <SolidColorBrush x:Key="Reg_AccentButton_IsMouseOver_BgColor_Brush" Color="#67D8FD" />
    <!--#endregion-->

    <!--#region  DialogWindowsStyles-->
    <SolidColorBrush x:Key="Main_BgColor_Brush" Color="#0B1220" />
    <SolidColorBrush x:Key="Secondary_BgColor_Brush" Color="#111B2E" />
    <SolidColorBrush x:Key="Text_FgColor_Brush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Border_BgColor_Brush" Color="#1F2A3A" />
    <SolidColorBrush x:Key="StackPanel_BgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="DataGridHeader_IsPressed_BgColor_Brush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="TextBox_Empty_BgColor_Brush" Color="#331F2937" />

    <SolidColorBrush x:Key="ComboBoxItem_BgGolor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="ComboBoxItem_FgGolor_Brush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ComboBoxItem_IsSelected_BgGolor_Brush" Color="#1E293B" />
    <SolidColorBrush x:Key="ComboBoxItem_IsSelected_FgGolor_Brush" Color="#34D399" />
    <!--#endregion-->

    <!--#region  MainWindowStyles-->
    <SolidColorBrush x:Key="MainContentBorder_BgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0D1526" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="AccentBrush" Color="#34D399" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B1220" />
    <SolidColorBrush x:Key="TextBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#1F2A3A" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#3DDCA1" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1F9D6C" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#1C2435" />
    <!--#endregion-->

    <!--#region  ViewsStyles-->
    <SolidColorBrush x:Key="Button_BgColor_Brush" Color="#22C55E" />
    <SolidColorBrush x:Key="Button_FgColor_Brush" Color="#0B1220" />  <!--E5E7EB-->
    <SolidColorBrush x:Key="Button_IsOver_BgColor_Brush" Color="#38D87A" />
    <SolidColorBrush x:Key="Button_IsPressed_BgColor_Brush" Color="#1B8A52" />
    <SolidColorBrush x:Key="Button_IsEnabled_BgColor_Brush" Color="#1C2435" />
    <SolidColorBrush x:Key="Button_IsEnabled_FgColor_Brush" Color="#4B5563" />

    <SolidColorBrush x:Key="Fg_Brush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="Fg_Anti_Brush" Color="#0B1220" />

