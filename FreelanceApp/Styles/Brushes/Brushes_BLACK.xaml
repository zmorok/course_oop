    <SolidColorBrush x:Key="TextComboBox_BgColor_Brush" Color="#111B2E" />
    <SolidColorBrush x:Key="TextComboBox_BdBrush_Brush" Color="#1F2937" />

    <!--  Border/StackPanel  -->
    <SolidColorBrush x:Key="BorderAndStackPanel_BgColor_Brush" Color="#0F172A" />

    <!--  ListBox  -->
    <SolidColorBrush x:Key="ListBox_BgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="ListBox_BdBrushColor_Brush" Color="#1F2937" />
    <SolidColorBrush x:Key="ListBoxItem_FgColor_Brush" Color="#E5E7EB" />
    <!--#endregion-->
</ResourceDictionary>
