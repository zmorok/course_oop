<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  Светлая тема  -->
    <sys:String x:Key="CurrentTheme">☀</sys:String>

    <!--  Общие кисти приложения  -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22C55E" Offset="0" />
        <GradientStop Color="#0EA5E9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#D8E1F0" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="InfoBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="InputFocusBrush" Color="#0EA5E9" />
    <Color x:Key="ShadowColor">#33000000</Color>

    <!--#region  AuthenticationStyles-->
    <SolidColorBrush x:Key="Login_Window_BgColor_Brush" Color="#F2F5FB" />
    <SolidColorBrush x:Key="Login_BorderMain_BgColor_Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Login_HeaderText_FgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="Login_Button1_BgColor_Brush" Color="#22C55E" />
    <SolidColorBrush x:Key="Login_Button1_FgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="Login_Button1_IsMouseOver_BgColor_Brush" Color="#2DD57A" />
    <SolidColorBrush x:Key="Login_Button2_BgColor_Brush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="Login_Button2_IsMouseOver_BgColor_Brush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="Login_TextBox_BgColor_Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Login_TextBox_FgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="Login_TextBox_BdColor_Brush" Color="#CBD5E1" />

    <!--  RegisterWindow  -->
    <SolidColorBrush x:Key="Reg_AccentButton_BgColor_Brush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="Reg_AccentButton_IsMouseOver_BgColor_Brush" Color="#38BDF8" />
    <!--#endregion-->

    <!--#region   DialogWindowsStyles-->
    <SolidColorBrush x:Key="Main_BgColor_Brush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="Secondary_BgColor_Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text_FgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="Border_BgColor_Brush" Color="#D8E1F0" />
    <SolidColorBrush x:Key="StackPanel_BgColor_Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridHeader_IsPressed_BgColor_Brush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="TextBox_Empty_BgColor_Brush" Color="#FFF4E5" />

    <SolidColorBrush x:Key="ComboBoxItem_BgGolor_Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxItem_FgGolor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="ComboBoxItem_IsSelected_BgGolor_Brush" Color="#E0F2FE" />
    <SolidColorBrush x:Key="ComboBoxItem_IsSelected_FgGolor_Brush" Color="#0F172A" />
    <!--#endregion-->

    <!--#region  MainWindowStyles-->
    <SolidColorBrush x:Key="MainContentBorder_BgColor_Brush" Color="#E6F4F1" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#22C55E" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F5F7FB" />
    <SolidColorBrush x:Key="TextBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D7DFEB" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#19B26B" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#15814D" />
    <SolidColorBrush x:Key="DisabledBrush" Color="#C6D4E3" />
    <!--#endregion-->

    <!--#region  ViewsStyles-->
    <SolidColorBrush x:Key="Button_BgColor_Brush" Color="#22C55E" />
    <SolidColorBrush x:Key="Button_FgColor_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="Button_IsOver_BgColor_Brush" Color="#2DD57A" />
    <SolidColorBrush x:Key="Button_IsPressed_BgColor_Brush" Color="#166534" />
    <SolidColorBrush x:Key="Button_IsEnabled_BgColor_Brush" Color="#C7CEDB" />
    <SolidColorBrush x:Key="Button_IsEnabled_FgColor_Brush" Color="#E2E8F0" />

    <SolidColorBrush x:Key="Fg_Brush" Color="#0F172A" />
    <SolidColorBrush x:Key="Fg_Anti_Brush" Color="#FFFFFF" />

    <!--  TextComboBox  -->
    <SolidColorBrush x:Key="TextComboBox_BgColor_Brush" Color="#F0F4F8" />
    <SolidColorBrush x:Key="TextComboBox_BdBrush_Brush" Color="#CBD5E1" />

    <!--  Border/StackPanel  -->
    <SolidColorBrush x:Key="BorderAndStackPanel_BgColor_Brush" Color="#FFFFFF" />

    <!--  ListBox  -->
    <SolidColorBrush x:Key="ListBox_BgColor_Brush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ListBox_BdBrushColor_Brush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ListBoxItem_FgColor_Brush" Color="#0F172A" />
    <!--#endregion-->
</ResourceDictionary>
