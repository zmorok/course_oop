<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PortfolioSectionBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="PortfolioHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="PortfolioLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Margin" Value="0,8,0,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="PortfolioCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="Width" Value="280" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="{DynamicResource ShadowColor}" BlurRadius="10" ShadowDepth="0" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PortfolioMediaImageStyle" TargetType="Image">
        <Setter Property="Height" Value="200" />
        <Setter Property="Width" Value="260" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="PortfolioTagStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,4,6,0" />
    </Style>

    <Style x:Key="PortfolioChipsPanelStyle" TargetType="WrapPanel">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="ItemHeight" Value="26" />
    </Style>

</ResourceDictionary>
