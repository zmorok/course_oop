<UserControl
    x:Class="FreelanceApp.Windows.UserControls.FreelancerSearchControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    xmlns:data="clr-namespace:DAL.Models.Views;assembly=DAL"
    xmlns:models="clr-namespace:DAL.Models.Tables;assembly=DAL"
    xmlns:conv="clr-namespace:FreelanceApp.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:FreelancerSearchViewModel}"
    Width="Auto" Height="Auto">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:MediaJsonToImageSourceConverter x:Key="MediaToImageConverter" />
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Поиск -->
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBox Width="250" Margin="0,0,6,0"
                     Style="{DynamicResource PanelTextBoxStyle}"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="{DynamicResource FreelancerSearch_Button_Search}"
                    Style="{DynamicResource PanelButtonStyle}"
                    Command="{Binding SearchCommand}"/>
        </StackPanel>

        <!-- Найденные фрилансеры -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Freelancers}"
                  SelectedItem="{Binding SelectedFreelancer}"
                  SelectionMode="Single"
                  Background="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type data:FreelancerRow}">
                    <Border
                        Margin="3"
                        Padding="10"
                        Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Фото фрилансера -->
                            <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Margin="0,0,10,0">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Width" Value="72" />
                                        <Setter Property="Height" Value="72" />
                                        <Setter Property="Stretch" Value="UniformToFill" />
                                        <Setter Property="Source" Value="{Binding Media, Converter={StaticResource MediaToImageConverter}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Media, Converter={StaticResource MediaToImageConverter}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- Текстовая часть -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextBrush}"
                                Text="{Binding FullName}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                FontSize="11"
                                Foreground="{DynamicResource MutedTextBrush}">
                                <Run Text="{DynamicResource FreelancerSearch_SkillsPrefix}" />
                                <Run Text="{Binding SkillsPreview}" />
                            </TextBlock>

                            <Button
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="140"
                                Margin="0,4,0,0"
                                Content="{DynamicResource FreelancerSearch_Button_SelectProject}"
                                Command="{Binding DataContext.OpenProjectPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding CanInvite}"
                                Style="{DynamicResource PanelButtonStyle}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Выбор проекта и отправка приглашения -->
        <Border Grid.Row="2" Padding="10" Margin="0,8,0,0"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="10"
                Visibility="{Binding IsProjectPickerVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"
                           Text="{DynamicResource FreelancerSearch_Label_SelectProject}"/>
                <ComboBox Width="280"
                          ItemsSource="{Binding OpenProjects}"
                          SelectedItem="{Binding SelectedProject}"
                          DisplayMemberPath="Title"
                          Style="{DynamicResource PanelComboBoxStyle}"/>
                <Button Margin="6,0,0,0"
                        Content="{DynamicResource FreelancerSearch_Button_Send}"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding SendInviteCommand}"/>
                <Button Margin="6,0,0,0"
                        Content="{DynamicResource FreelancerSearch_Button_Cancel}"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding DataContext.CloseProjectPickerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
