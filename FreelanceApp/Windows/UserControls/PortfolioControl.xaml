<UserControl
    x:Class="FreelanceApp.Windows.UserControls.PortfolioControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    d:DataContext="{d:DesignInstance Type=vm:PortfolioViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель: действия и форма (с прокруткой) -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,14,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Border Style="{DynamicResource PortfolioSectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource PortfolioHeaderTextStyle}" Text="{DynamicResource Portfolio_Header_Manage}" />

                    <StackPanel 
                        Orientation="Horizontal"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Button
                            Width="120"
                            Command="{Binding AddCommand}"
                            Content="{DynamicResource Portfolio_Button_Add}" />
                        <Button
                            Width="120"
                            Command="{Binding DeleteSelectedCommand}"
                            Content="{DynamicResource Portfolio_Button_Delete}" />
                    </StackPanel>

                    <StackPanel
                        x:Name="AddFormPanel"
                        Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{DynamicResource PortfolioLabelStyle}" Text="{DynamicResource Portfolio_Label_Description}" />
                        <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource PortfolioLabelStyle}" Text="{DynamicResource Portfolio_Label_Experience}" />
                        <TextBox Text="{Binding FormExperience, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource PortfolioLabelStyle}" Text="{DynamicResource Portfolio_Label_SkillsCsv}" />
                        <TextBox Text="{Binding FormSkills, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource PortfolioLabelStyle}" Text="{DynamicResource Portfolio_Label_Image}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button
                                Width="140"
                                Command="{Binding SelectImageCommand}"
                                Content="{DynamicResource Portfolio_Button_SelectFile}" />
                            <TextBlock
                                Margin="8,6,0,0"
                                Foreground="{DynamicResource MutedTextBrush}"
                                Text="{Binding FormImageName}" />
                        </StackPanel>

                        <Image>
                            <Image.Style>
                                <Style TargetType="Image" BasedOn="{StaticResource PortfolioMediaImageStyle}">
                                    <Setter Property="Source" Value="{Binding FormImagePreview}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormImagePreview}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button
                                Width="140"
                                Command="{Binding ClearImageCommand}"
                                Content="{DynamicResource Portfolio_Button_RemoveImage}" />
                        </StackPanel>

                        <StackPanel 
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0">
                            <Button
                                Width="120"
                                Command="{Binding SaveCommand}"
                                Content="{DynamicResource Portfolio_Button_Save}" />
                            <Button
                                Width="120"
                                Command="{Binding CancelCommand}"
                                Content="{DynamicResource Portfolio_Button_Cancel}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Правая колонка: карточки портфолио -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Portfolios}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource PortfolioCardStyle}">
                            <StackPanel>
                                <TextBlock
                                    FontWeight="Bold"
                                    FontSize="15"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="{Binding Description}" />
                                <TextBlock
                                    Margin="0,4,0,8"
                                    Text="{Binding Experience}"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource MutedTextBrush}" />

                                <Image>
                                    <Image.Style>
                                        <Style TargetType="Image" BasedOn="{StaticResource PortfolioMediaImageStyle}">
                                            <Setter Property="Source"
                                                    Value="{Binding Model.Media, Converter={StaticResource MediaToImageConverter}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Model.Media, Converter={StaticResource MediaToImageConverter}}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <TextBlock
                                    Text="{DynamicResource Portfolio_Text_NoMedia}"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Margin="0,0,0,8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Model.Media, Converter={StaticResource MediaToImageConverter}}"
                                                             Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <WrapPanel Style="{DynamicResource PortfolioChipsPanelStyle}">
                                    <ItemsControl ItemsSource="{Binding SkillsList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{DynamicResource PortfolioTagStyle}">
                                                    <TextBlock Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </WrapPanel>

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="0,8,0,0">
                                    <Button
                                        Content="{DynamicResource Portfolio_Button_Edit}"
                                        Command="{Binding DataContext.SelectForEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                    <Button
                                        Content="{DynamicResource Portfolio_Button_DeleteItem}"
                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
