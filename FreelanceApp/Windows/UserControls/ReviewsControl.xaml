<UserControl
    x:Class="FreelanceApp.Windows.UserControls.ReviewsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Переключатель режима: я заказчик / я исполнитель -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
                Text="{DynamicResource Reviews_Mode_Label}"
                VerticalAlignment="Center"
                Margin="0,0,10,0"
                Foreground="{DynamicResource MutedTextBrush}" />
            <RadioButton
                Content="{DynamicResource Reviews_Mode_AsCustomer}"
                Style="{DynamicResource ReviewsModeRadioButtonStyle}"
                IsChecked="{Binding AsCustomer, Mode=TwoWay}" />
            <RadioButton
                Content="{DynamicResource Reviews_Mode_AsFreelancer}"
                Style="{DynamicResource ReviewsModeRadioButtonStyle}"
                IsChecked="{Binding AsFreelancer, Mode=TwoWay}" />
        </StackPanel>

        <!-- Список архивных заказов + мои/их отзывы (виден только когда форма редактирования закрыта) -->
        <ListView x:Name="ArchiveList"
                  Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  SelectionMode="Single"
                  Background="Transparent"
                  BorderThickness="0"
                  MinHeight="300">
            <ListView.Style>
                <Style TargetType="ListView">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.Style>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource ReviewCardBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Левая колонка -->
                            <StackPanel Grid.Column="0" Grid.IsSharedSizeScope="True">
                                <!-- Название проекта -->
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="{Binding ProjectTitle, Mode=OneWay}" />

                                <!-- Имя другого участника -->
                                <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}">
                                    <Run Text="{DynamicResource Reviews_Label_OtherSide}" />
                                    <Run Text="{Binding OtherSideName, Mode=OneWay}" />
                                </TextBlock>

                                <!-- Мой отзыв -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ReviewLabel" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{DynamicResource ReviewsInlineLabelStyle}"
                                        Text="{DynamicResource Reviews_Label_MyReview}" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Foreground="DarkGoldenrod"
                                                Text="{Binding MyRating, Mode=OneWay, StringFormat='({0}/5)', TargetNullValue=''}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                Style="{DynamicResource ReviewsInlineLabelStyle}"
                                                Text="{Binding MyCommentPreview, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Image>
                                            <Image.Style>
                                                <Style TargetType="Image" BasedOn="{StaticResource ReviewThumbnailImageStyle}">
                                                    <Setter Property="Source"
                                                            Value="{Binding MyMedia, Converter={StaticResource MediaToImageConverter}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MyMedia, Converter={StaticResource MediaToImageConverter}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                </Grid>

                                <!-- Отзыв оппонента -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="ReviewLabel" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{DynamicResource ReviewsInlineLabelStyle}"
                                        Text="{DynamicResource Reviews_Label_OpponentReview}" />
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                Foreground="DarkGoldenrod"
                                                Text="{Binding OppRating, Mode=OneWay, StringFormat='({0}/5)', TargetNullValue=''}" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                Style="{DynamicResource ReviewsInlineLabelStyle}"
                                                Text="{Binding OppCommentPreview, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Image>
                                            <Image.Style>
                                                <Style TargetType="Image" BasedOn="{StaticResource ReviewThumbnailImageStyle}">
                                                    <Setter Property="Source"
                                                            Value="{Binding OppMedia, Converter={StaticResource MediaToImageConverter}}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding OppMedia, Converter={StaticResource MediaToImageConverter}}"
                                                                     Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Правая колонка: кнопки -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Кнопка добавления/редактирования отзыва с локализацией -->
                            <Button
                                Width="90"
                                Margin="0,0,0,4"
                                Command="{Binding DataContext.OpenEditForCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
                                        <!-- По умолчанию считаем, что отзыв есть (Edit) -->
                                        <Setter Property="Content" Value="{DynamicResource Reviews_Button_Edit}" />
                                        <Style.Triggers>
                                            <!-- Если ReviewId == null, показываем "Добавить" -->
                                            <DataTrigger Binding="{Binding ReviewId}" Value="{x:Null}">
                                                <Setter Property="Content" Value="{DynamicResource Reviews_Button_Add}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Кнопка удаления с локализацией -->
                            <Button
                                Width="90"
                                Content="{DynamicResource Reviews_Button_Delete}"
                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                CommandParameter="{Binding}" />
                        </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Панель добавления/редактирования отзыва (показывается вместо списка) -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVis}}">
            <Border
                Style="{DynamicResource ReviewsEditBorderStyle}">
                <StackPanel>
                    <TextBlock
                        Style="{DynamicResource ReviewsHeaderTextStyle}"
                        Text="{Binding PanelTitle, Mode=OneWay}" />

                    <TextBlock Style="{DynamicResource ReviewsLabelTextStyle}" Text="{DynamicResource Reviews_Edit_Label_Rating}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                        <ComboBox
                            Style="{DynamicResource ReviewsRatingComboBoxStyle}"
                            SelectedValuePath="Content"
                            SelectedValue="{Binding EditRating, Mode=TwoWay}">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                        </ComboBox>
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="DarkGoldenrod"
                            Text="★" />
                    </StackPanel>

                    <TextBlock Style="{DynamicResource ReviewsLabelTextStyle}" Text="{DynamicResource Reviews_Edit_Label_Comment}" />
                    <TextBox
                        Height="60"
                        TextWrapping="Wrap"
                        Text="{Binding EditComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{DynamicResource ReviewsLabelTextStyle}" Text="{DynamicResource Reviews_Edit_Label_Image}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button
                            Width="140"
                            Margin="0,0,8,0"
                            Content="{DynamicResource Reviews_Edit_Button_SelectFile}"
                            Command="{Binding SelectImageCommand}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="{Binding EditImageName}" />
                    </StackPanel>

                    <Image
                        Style="{DynamicResource ReviewEditorImageStyle}"
                        Source="{Binding EditImagePreview}"
                        Visibility="{Binding HasEditImage, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Orientation="Horizontal">
                        <Button
                            Width="140"
                            Content="{DynamicResource Reviews_Edit_Button_RemoveImage}"
                            Command="{Binding ClearImageCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button
                            Width="100"
                            Content="{DynamicResource Reviews_Edit_Button_Save}"
                            Command="{Binding SaveCommand}" />
                        <Button
                            Width="80"
                            Content="{DynamicResource Reviews_Edit_Button_Cancel}"
                            Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
