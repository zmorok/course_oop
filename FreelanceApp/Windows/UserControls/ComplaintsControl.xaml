<UserControl
    x:Class="FreelanceApp.Windows.UserControls.ComplaintsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    xmlns:data="clr-namespace:DAL.Models.Views;assembly=DAL"
    xmlns:conv="clr-namespace:FreelanceApp.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ComplaintsViewModel}"
    d:DesignWidth="900"
    d:DesignHeight="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis"/>
        <conv:NullToFalseConverter x:Key="NullToFalse"/>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Переключение режимов ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock Text="Режим: " VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton Content="Подача жалобы" Margin="0,0,10,0"
                             IsChecked="{Binding IsCreateMode}"/>
                <RadioButton Content="Мои жалобы"
                             IsChecked="{Binding IsMyComplaintsMode}"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== Режим: Подача жалобы ===== -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsCreateMode, Converter={StaticResource Bool2Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Контрагенты -->
            <GroupBox Header="Контрагенты">
                <ListView ItemsSource="{Binding Counterparts}"
                          SelectedItem="{Binding SelectedCounterpart}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="6" BorderBrush="#DDD" BorderThickness="1">
                                <TextBlock VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Text="{Binding FullName}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>

            <Grid Grid.Column="1"/>

            <!-- Заказы выбранного контрагента -->
            <GroupBox Grid.Column="2" Header="Заказы с выбранным контрагентом">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ВАЖНО: без внешнего ScrollViewer – иначе ломается DoubleClick -->
                    <ListView Grid.Row="0"
                              ItemsSource="{Binding CounterpartOrders}"
                              SelectedItem="{Binding SelectedOrder}">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type data:LocalOrderDisplay}">
                                <Border Margin="4" Padding="8" BorderBrush="#DDD" BorderThickness="1">
                                    <!-- Двойной клик по карточке заказа -->
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenCreatePanelCommand,
                                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis">
                                            <Run Text="Проект: "/>
                                            <Run Text="{Binding ProjectTitle, FallbackValue='[нет данных]'}"/>
                                            <Run Text=" (Заказ №"/>
                                            <Run Text="{Binding OrderId}"/>
                                            <Run Text=")"/>
                                        </TextBlock>

                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,10,0" Text="{Binding OrderStatus}"/>
                                            <TextBlock>
                                                <Run Text="Дедлайн: "/>
                                                <Run Text="{Binding OrderDeadline, StringFormat='dd.MM.yyyy', TargetNullValue='—'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock>
                                                <Run Text="Заказчик: "/>
                                                <Run Text="{Binding CustomerFullName, TargetNullValue='?'}"/>
                                            </TextBlock>
                                            <TextBlock>
                                                <Run Text="Исполнитель: "/>
                                                <Run Text="{Binding FreelancerFullName, TargetNullValue='?'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                                   FontSize="11" Foreground="Gray">
                                            <Run Text="Создан: "/>
                                            <Run Text="{Binding OrderCreationDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Пожаловаться на заказ"
                                Command="{Binding OpenCreatePanelCommand}"
                                CommandParameter="{Binding SelectedOrder}"
                                IsEnabled="{Binding SelectedOrder, Converter={StaticResource NullToFalse}}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ===== Режим: Мои жалобы ===== -->
        <GroupBox Grid.Row="1" Header="Мои жалобы"
                  Visibility="{Binding IsMyComplaintsMode, Converter={StaticResource Bool2Vis}}">
            <ListView ItemsSource="{Binding MyComplaints}"
                      SelectedItem="{Binding SelectedMyComplaint}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4" Padding="6" BorderBrush="#DDD" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock>
                                        <Run Text="Адресат: "/>
                                        <Run Text="{Binding TargetName}"/>
                                        <Run Text="| Жалобу можно изменить"/>
                                        <Run Text="{Binding RemainingChanges, Mode=OneWay}" />
                                        <Run Text="раз."/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="Gray" Text="{Binding Status}"/>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding DescriptionPreview}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Width="80" Margin="0,0,0,4"
                                            Content="Изменить"
                                            Visibility="{Binding IsEditable, Converter={StaticResource Bool2Vis}}"
                                            Command="{Binding DataContext.EditMineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Width="80"
                                            Content="Удалить"
                                            Visibility="{Binding IsEditable, Converter={StaticResource Bool2Vis}}"
                                            Command="{Binding DataContext.DeleteMineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <!-- ===== Панель создания/редактирования ===== -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="12"
                Background="WhiteSmoke" BorderBrush="Gray" BorderThickness="1"
                Visibility="{Binding IsEditOpen, Converter={StaticResource Bool2Vis}}">
            <StackPanel>
                <TextBlock FontSize="15" FontWeight="Bold" Text="{Binding PanelTitle}"/>
                <TextBlock Margin="0,8,0,0" Text="Текст жалобы:"/>
                <TextBox Height="80" TextWrapping="Wrap"
                         Text="{Binding ComplaintText, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Width="110" Margin="0,0,6,0" Content="Сохранить" Command="{Binding SaveCommand}"/>
                    <Button Width="80" Content="Отмена" Command="{Binding CancelCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
