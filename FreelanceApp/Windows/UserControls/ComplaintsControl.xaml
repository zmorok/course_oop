<UserControl
    x:Class="FreelanceApp.Windows.UserControls.ComplaintsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    xmlns:data="clr-namespace:DAL.Models.Views;assembly=DAL"
    xmlns:conv="clr-namespace:FreelanceApp.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ComplaintsViewModel}"
    d:DesignWidth="900"
    d:DesignHeight="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis" />
        <conv:NullToFalseConverter x:Key="NullToFalse" />
        
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Переключение режимов ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock
                    Text="Режим:"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource MutedTextBrush}" />
                <RadioButton
                    Content="Подача жалобы"
                    Margin="0,0,10,0"
                    Foreground="{DynamicResource TextBrush}"
                    IsChecked="{Binding IsCreateMode}" />
                <RadioButton
                    Content="Мои жалобы"
                    Foreground="{DynamicResource TextBrush}"
                    IsChecked="{Binding IsMyComplaintsMode}" />
            </StackPanel>
        </DockPanel>

        <!-- ===== Режим: Подача жалобы ===== -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <!-- показываем, когда включён режим создания и редактор закрыт -->
                        <DataTrigger Binding="{Binding IsCreateMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Контрагенты -->
            <GroupBox Header="Контрагенты">
                <ListView
                    ItemsSource="{Binding Counterparts}"
                    SelectedItem="{Binding SelectedCounterpart}"
                    Background="Transparent"
                    HorizontalContentAlignment="Stretch">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource ComplaintListItemCardStyle}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="{Binding FullName}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </GroupBox>

            <Grid Grid.Column="1"/>

            <!-- Заказы выбранного контрагента -->
            <GroupBox Grid.Column="2" Header="Заказы с выбранным контрагентом">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView
                        Grid.Row="0"
                        ItemsSource="{Binding CounterpartOrders}"
                        SelectedItem="{Binding SelectedOrder}"
                        Background="Transparent"
                        HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type data:LocalOrderDisplay}">
                                <Border Style="{DynamicResource ComplaintListItemCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextBrush}"
                                            TextTrimming="CharacterEllipsis">
                                            <Run Text="Проект: "/>
                                            <Run Text="{Binding ProjectTitle, FallbackValue='[нет данных]'}"/>
                                            <Run Text=" (Заказ №"/>
                                            <Run Text="{Binding OrderId}"/>
                                            <Run Text=")"/>
                                        </TextBlock>

                                          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                              <TextBlock
                                                  Margin="0,0,10,0"
                                                  Foreground="{DynamicResource MutedTextBrush}"
                                                  Text="{Binding OrderStatus}" />
                                              <TextBlock Foreground="{DynamicResource MutedTextBrush}">
                                                <Run Text="Дедлайн: "/>
                                                <Run Text="{Binding OrderDeadline, StringFormat='dd.MM.yyyy', TargetNullValue='—'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                          <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                              <TextBlock Foreground="{DynamicResource TextBrush}">
                                                <Run Text="Заказчик: "/>
                                                <Run Text="{Binding CustomerFullName, TargetNullValue='?'}"/>
                                            </TextBlock>
                                              <TextBlock Foreground="{DynamicResource TextBrush}">
                                                <Run Text="Исполнитель: "/>
                                                <Run Text="{Binding FreelancerFullName, TargetNullValue='?'}"/>
                                            </TextBlock>
                                        </StackPanel>

                                          <TextBlock
                                              Grid.Row="2"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              FontSize="11"
                                              Foreground="{DynamicResource MutedTextBrush}">
                                            <Run Text="Создан: "/>
                                            <Run Text="{Binding OrderCreationDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button Content="Пожаловаться на заказ"
                                Command="{Binding OpenCreatePanelCommand}"
                                CommandParameter="{Binding SelectedOrder}"
                                IsEnabled="{Binding SelectedOrder, Converter={StaticResource NullToFalse}}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- ===== Режим: Мои жалобы ===== -->
        <GroupBox Grid.Row="1" Header="Мои жалобы" Foreground="{DynamicResource TextBrush}">
            <GroupBox.Style>
                <Style TargetType="GroupBox">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <!-- показываем, когда включён режим "Мои жалобы" и редактор закрыт -->
                        <DataTrigger Binding="{Binding IsMyComplaintsMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GroupBox.Style>
            <ListView
                ItemsSource="{Binding MyComplaints}"
                SelectedItem="{Binding SelectedMyComplaint}"
                Background="Transparent"
                HorizontalContentAlignment="Stretch">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource ComplaintMyCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock>
                                        <Run Text="Адресат: " Foreground="{DynamicResource TextBrush}" />
                                        <Run Text="{Binding TargetName}" Foreground="{DynamicResource TextBrush}" />
                                        <Run Text="| Жалобу можно изменить" Foreground="{DynamicResource TextBrush}" />
                                        <Run Text="{Binding RemainingChanges, Mode=OneWay}" Foreground="{DynamicResource TextBrush}" />
                                        <Run Text="раз." Foreground="{DynamicResource TextBrush}" />
                                    </TextBlock>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        Text="{Binding Status}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Foreground="{DynamicResource TextBrush}"
                                        Text="{Binding DescriptionPreview}"
                                        TextWrapping="Wrap" />
                                    <Image>
                                        <Image.Style>
                                            <Style TargetType="Image" BasedOn="{StaticResource ComplaintThumbnailImageStyle}">
                                                <Setter Property="Source"
                                                        Value="{Binding Media, Converter={StaticResource MediaToImageConverter}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Media, Converter={StaticResource MediaToImageConverter}}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource MutedTextBrush}"
                                        Text="Медиа отсутствует">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Media, Converter={StaticResource MediaToImageConverter}}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Width="80" Margin="0,0,0,4"
                                            Content="Изменить"
                                            Visibility="{Binding IsEditable, Converter={StaticResource Bool2Vis}}"
                                            Command="{Binding DataContext.EditMineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Width="80"
                                            Content="Удалить"
                                            Visibility="{Binding IsEditable, Converter={StaticResource Bool2Vis}}"
                                            Command="{Binding DataContext.DeleteMineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <!-- ===== Панель создания/редактирования (вместо списков) ===== -->
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding IsEditOpen, Converter={StaticResource Bool2Vis}}">
            <Border Style="{DynamicResource ComplaintsEditBorderStyle}">
                <StackPanel>
                    <TextBlock
                        Style="{DynamicResource ComplaintsHeaderTextStyle}"
                        Text="{Binding PanelTitle}" />

                    <TextBlock
                        Style="{DynamicResource ComplaintsLabelTextStyle}"
                        Text="Текст жалобы:" />
                    <TextBox
                        Height="80"
                        TextWrapping="Wrap"
                        Text="{Binding ComplaintText, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Style="{DynamicResource ComplaintsLabelTextStyle}"
                        Text="Изображение:" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button
                            Width="140"
                            Margin="0,0,8,0"
                            Content="Выбрать файл..."
                            Command="{Binding SelectImageCommand}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MutedTextBrush}"
                            Text="{Binding EditImageName}" />
                    </StackPanel>

                    <Image
                        Style="{DynamicResource ComplaintsEditImageStyle}"
                        Source="{Binding EditImagePreview}"
                        Visibility="{Binding HasEditImage, Converter={StaticResource Bool2Vis}}" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button
                            Width="140"
                            Content="Убрать изображение"
                            Command="{Binding ClearImageCommand}" />
                    </StackPanel>

                    <StackPanel 
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,10,0,0">
                        <Button
                            Width="110"
                            Content="Сохранить"
                            Command="{Binding SaveCommand}" />
                        <Button
                            Width="80"
                            Content="Отмена"
                            Command="{Binding CancelCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
