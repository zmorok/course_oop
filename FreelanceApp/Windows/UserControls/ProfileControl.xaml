<UserControl
    x:Class="FreelanceApp.Windows.UserControls.ProfileControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dt="clr-namespace:DAL.Models.Tables;assembly=DAL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10" Background="Transparent">

            <!--  === Мой профиль ===  -->
            <Border Style="{DynamicResource ProfileSectionBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Style="{DynamicResource ProfileHeaderTextStyle}" Text="{DynamicResource Profile_Header_MyProfile}" />
                        <Image Style="{DynamicResource ProfileAvatarStyle}" Source="{Binding Photo}" />
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                            <Button
                                Width="120"
                                Command="{Binding UploadPhotoCommand}"
                                Content="{DynamicResource Profile_Button_UploadPhoto}" />
                            <Button
                                Width="120"
                                Command="{Binding DeletePhotoCommand}"
                                Content="{DynamicResource Profile_Button_RemovePhoto}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{DynamicResource ProfileLabelStyle}" Text="{DynamicResource Profile_Label_FirstName}" />
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource ProfileLabelStyle}" Text="{DynamicResource Profile_Label_LastName}" />
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource ProfileLabelStyle}" Text="{DynamicResource Profile_Label_MiddleName}" />
                        <TextBox Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource ProfileLabelStyle}" Text="Email" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource ProfileLabelStyle}" Text="{DynamicResource Profile_Label_Phone}" />
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource ProfileLabelStyle}" Text="{DynamicResource Profile_Label_Gender}" />
                        <ComboBox
                            Style="{DynamicResource ProfileComboBoxStyle}"
                            ItemsSource="{Binding Genders, UpdateSourceTrigger=PropertyChanged}"
                            SelectedItem="{Binding SelectedGender}" />

                        <TextBlock Style="{DynamicResource ProfileLabelStyle}" Text="{DynamicResource Profile_Label_NewPassword}" />
                        <PasswordBox
                            x:Name="PasswordBox"
                            Style="{DynamicResource ProfilePasswordBoxStyle}"
                            PasswordChanged="OnPasswordChanged" />

                        <Button
                            Width="200"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Command="{Binding SaveCommand}"
                            Content="{DynamicResource Profile_Button_SaveChanges}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  === Уведомления ===  -->
            <Border Style="{DynamicResource ProfileSectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource ProfileHeaderTextStyle}" Text="{DynamicResource Profile_Header_Invitations}" />
                    <ScrollViewer Height="220" VerticalScrollBarVisibility="Auto">
                        <ListView
                            Margin="0,4,0,0"
                            ItemsSource="{Binding Notifications}"
                            Style="{DynamicResource ProfileListViewStyle}"
                            ItemContainerStyle="{DynamicResource ProfileListViewItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type dt:UserNotification}">
                                    <Border Style="{DynamicResource ProfileCardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextBrush}"
                                                Text="{Binding Project_Title}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource MutedTextBrush}"
                                                Text="{Binding Sender_Name}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource MutedTextBrush}"
                                                Text="{Binding Created_At, StringFormat='dd.MM.yyyy HH:mm'}" />

                                            <StackPanel
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal">
                                                <Button
                                                    Width="110"
                                                    Command="{Binding DataContext.AcceptInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Profile_Button_Accept}" />
                                                <Button
                                                    Width="110"
                                                    Command="{Binding DataContext.DeclineInviteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{DynamicResource Profile_Button_Reject}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!--  === Предупреждения ===  -->
            <Border Style="{DynamicResource ProfileSectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource ProfileHeaderTextStyle}" Text="{DynamicResource Profile_Header_Warnings}" />
                    <ListView
                        Height="220"
                        ItemsSource="{Binding Warnings}"
                        Style="{DynamicResource ProfileListViewStyle}"
                        ItemContainerStyle="{DynamicResource ProfileListViewItemStyle}">
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type dt:UserWarning}">
                                <Border Style="{DynamicResource ProfileCardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Foreground="{DynamicResource TextBrush}">
                                            <Run Text="{DynamicResource Profile_Warning_Prefix}" />
                                            <Run FontWeight="Bold" Text="{Binding WarningId}" />
                                            <Run Text="{DynamicResource Profile_Warning_ResolvedBy}" />
                                            <Run FontWeight="Bold" Text="{Binding AdminName}" />
                                        </TextBlock>

                                        <TextBlock
                                            MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            Margin="0,4,0,0"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource TextBrush}">
                                            <Run Text="{DynamicResource Profile_Warning_Text}" />
                                            <Run Text="{Binding Message}" />
                                        </TextBlock>

                                        <TextBlock
                                            Margin="0,4,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource MutedTextBrush}">
                                            <Run Text="{DynamicResource Profile_Warning_ValidUntil}" />
                                            <Run Text="{Binding ExpiresAt, StringFormat='dd.MM.yyyy'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
