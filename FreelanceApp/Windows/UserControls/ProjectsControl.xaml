<UserControl
    x:Class="FreelanceApp.Windows.UserControls.ProjectsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:ProjectsViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая панель: управление и форма проекта (с прокруткой) -->
        <ScrollViewer
            Grid.Column="0"
            Margin="0,0,14,0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <Border Style="{DynamicResource ProjectsSectionBorderStyle}">
                <StackPanel>
                    <TextBlock Style="{DynamicResource ProjectsHeaderTextStyle}" Text="Управление проектами" />

                    <!-- Основные действия -->
                    <StackPanel 
                        Orientation="Horizontal"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Button
                            Width="70"
                            Style="{DynamicResource PanelButtonStyle}"
                            Command="{Binding AddCommand}"
                            Content="Добавить" />
                        <Button
                            Width="70"
                            Style="{DynamicResource PanelButtonStyle}"
                            Command="{Binding EditCommand}"
                            Content="Обновить" />
                        <Button
                            Width="70"
                            Style="{DynamicResource PanelButtonStyle}"
                            Command="{Binding DeleteCommand}"
                            Content="Удалить" />
                    </StackPanel>

                    <Button
                        Width="200"
                        Margin="0,0,0,10"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding ToggleMineCommand}"
                        Content="{Binding ToggleMineButtonText}" />

                    <!-- Фильтр по статусу -->
                    <TextBlock Style="{DynamicResource ProjectsLabelStyle}" Text="Фильтр по статусу:" />
                    <ComboBox
                        Style="{DynamicResource ProjectsFilterComboBoxStyle}"
                        SelectedValue="{Binding StatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="Все" Tag="" IsSelected="True" />
                        <ComboBoxItem Content="Черновик" Tag="draft" />
                        <ComboBoxItem Content="Открыт" Tag="open" />
                        <ComboBoxItem Content="В прогрессе" Tag="in_progress" />
                    </ComboBox>

                    <!-- Форма -->
                    <StackPanel
                        Margin="0,10,0,0"
                        Visibility="{Binding IsFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Style="{DynamicResource ProjectsLabelStyle}" Text="Название" />
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource ProjectsLabelStyle}" Text="Описание" />
                        <TextBox
                            MinHeight="60"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"
                            Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Style="{DynamicResource ProjectsLabelStyle}" Text="Статус" />
                        <ComboBox
                            Style="{DynamicResource ProjectsStatusComboBoxStyle}"
                            SelectedValue="{Binding SelectedStatus}"
                            SelectedValuePath="Tag">
                            <ComboBoxItem Content="Черновик" Tag="draft" />
                            <ComboBoxItem Content="Открыт" Tag="open" />
                            <ComboBoxItem Content="В прогрессе" Tag="in_progress" />
                        </ComboBox>

                        <TextBlock Style="{DynamicResource ProjectsLabelStyle}" Text="Изображение" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button
                                Width="140"
                                Style="{DynamicResource PanelButtonStyle}"
                                Command="{Binding SelectImageCommand}"
                                Content="Выбрать файл..." />
                            <TextBlock
                                Margin="8,6,0,0"
                                Foreground="{DynamicResource MutedTextBrush}"
                                Text="{Binding FormImageName}" />
                        </StackPanel>

                        <!-- Превью изображения (без закруглений) -->
                        <Image>
                            <Image.Style>
                                <Style TargetType="Image" BasedOn="{StaticResource ProjectMediaImageStyle}">
                                    <Setter Property="Source" Value="{Binding FormImagePreview}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormImagePreview}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button
                                Width="140"
                                Style="{DynamicResource PanelButtonStyle}"
                                Command="{Binding ClearImageCommand}"
                                Content="Убрать изображение" />
                        </StackPanel>

                        <StackPanel 
                            Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="0,10,0,0">
                            <Button
                                Width="120"
                                Style="{DynamicResource PanelButtonStyle}"
                                Command="{Binding SaveCommand}"
                                Content="Сохранить" />
                            <Button
                                Width="120"
                                Style="{DynamicResource PanelButtonStyle}"
                                Command="{Binding CancelCommand}"
                                Content="Отмена" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Правая панель: карточки проектов -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource ProjectCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Foreground="{DynamicResource TextBrush}"
                                    Text="{Binding Project.Title}" />

                                <Border Style="{DynamicResource ProjectStatusChipStyle}">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextBrush}">
                                        <Run Text="Статус: " />
                                        <Run Text="{Binding StatusDisplay, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>

                                <Image
                                    Style="{DynamicResource ProjectMediaImageStyle}"
                                    Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Source="{Binding ImageSource}" />

                                <TextBlock
                                    Margin="0,4,0,2"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource MutedTextBrush}"
                                    Text="Описание:" />
                                <TextBlock
                                    MaxHeight="80"
                                    Text="{Binding Project.Description, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Foreground="{DynamicResource TextBrush}" />

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button
                                        Margin="0,0,8,0"
                                        Content="Откликнуться"
                                        Style="{DynamicResource PanelButtonStyle}"
                                        Visibility="{Binding ShowRespondButton, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.RespondCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                    <Button
                                        Content="Редактировать"
                                        Style="{DynamicResource PanelButtonStyle}"
                                        Visibility="{Binding IsMine, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.SelectForEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
