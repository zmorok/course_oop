<UserControl
    x:Class="FreelanceApp.Windows.UserControls.OrdersControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:FreelanceApp.Converters"
    xmlns:data="clr-namespace:DAL.Models.Views;assembly=DAL"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NullToFalseConverter x:Key="NullToFalseConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель: переключение представления + действия -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">

            <!-- Переключение: заказчик / исполнитель / архив -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Показать:" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <RadioButton Margin="5"
                             Foreground="{DynamicResource TextBrush}"
                             Content="Мои заказы (я заказчик)"
                             IsChecked="{Binding IsCustomerView}"/>
                <RadioButton Margin="5"
                             Foreground="{DynamicResource TextBrush}"
                             Content="Мои заказы (я исполнитель)"
                             IsChecked="{Binding IsFreelancerView}"/>
                <RadioButton Margin="5"
                             Foreground="{DynamicResource TextBrush}"
                             Content="Архив"
                             IsChecked="{Binding IsArchiveView}"/>
            </StackPanel>

            <!-- Действия: редактировать / удалить (скрыты в архиве) -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="180" Margin="5"
                        Content="Изменить статус/дедлайн"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding EditSelectedCommand}"
                        Visibility="{Binding ShowEditActions, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{Binding SelectedRow, Converter={StaticResource NullToFalseConverter}}"/>
                <Button Width="140" Margin="5"
                        Content="Отменить/Удалить"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding DeleteSelectedCommand}"
                        Visibility="{Binding ShowEditActions, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{Binding SelectedRow, Converter={StaticResource NullToFalseConverter}}"/>
            </StackPanel>
        </DockPanel>

        <!-- Список заказов -->
        <ListView x:Name="OrdersListView"
                  Grid.Row="1"
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedRow}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <!-- Двойной клик = открыть редактирование (если не архив) -->
            <ListView.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick"
                              Command="{Binding OpenEditForCommand}"
                              CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListView}}"/>
            </ListView.InputBindings>

            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type data:LocalOrderDisplay}">
                    <Border Margin="5" Padding="10"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Заголовок: проект + номер заказа -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,5"
                                       FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}">
                                <Run Text="Проект: "/>
                                <Run Text="{Binding ProjectTitle, FallbackValue='[Загрузка...]', TargetNullValue='[Проект не найден]'}"/>
                                <Run Text=" (Заказ №"/>
                                <Run Text="{Binding OrderId}"/>
                                <Run Text=")"/>
                            </TextBlock>

                            <!-- Статус и дедлайн -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Margin="0,0,15,0" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           Text="{Binding OrderStatus}"/>
                                <TextBlock Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Дедлайн: "/>
                                    <Run Text="{Binding OrderDeadline, StringFormat='dd.MM.yyyy', FallbackValue='Не указан', TargetNullValue='Не указан'}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Заказчик / Исполнитель -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,3,0,3">
                                <TextBlock Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Заказчик: "/>
                                    <Run Text="{Binding CustomerFullName, FallbackValue='', TargetNullValue='?'}"/>
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Исполнитель: "/>
                                    <Run Text="{Binding FreelancerFullName, FallbackValue='', TargetNullValue='?'}"/>
                                </TextBlock>
                            </StackPanel>

                            <!-- Дата создания -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                <Run Text="Создан: "/>
                                <Run Text="{Binding OrderCreationDate, StringFormat='dd.MM.yyyy HH:mm'}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Панель редактирования -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="15"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                CornerRadius="12"
                Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Margin="0,0,0,15" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           Text="Изменение заказа"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,5"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Text="Статус:"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding EditStatus}"
                              Style="{DynamicResource PanelComboBoxStyle}">
                        <ComboBoxItem Content="Ожидает"  Tag="pending"/>
                        <ComboBoxItem Content="В работе" Tag="active"/>
                        <ComboBoxItem Content="Завершен" Tag="completed"/>
                        <ComboBoxItem Content="Отменён"  Tag="cancelled"/>
                        <ComboBoxItem Content="Спор"     Tag="disputed"/>
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,5"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Text="Дедлайн:"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"
                                SelectedDate="{Binding EditDeadline}"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <StackPanel Margin="0,15,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="120" Margin="5" Content="Сохранить"
                            Style="{DynamicResource PanelButtonStyle}"
                            Command="{Binding SaveCommand}"/>
                    <Button Width="120" Margin="5" Content="Отмена"
                            Style="{DynamicResource PanelButtonStyle}"
                            Command="{Binding CancelEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
