<UserControl
    x:Class="FreelanceApp.Windows.UserControls.OrdersControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="clr-namespace:FreelanceApp.Converters"
    xmlns:data="clr-namespace:DAL.Models.Views;assembly=DAL"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:NullToFalseConverter x:Key="NullToFalseConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: переключение представления + действия -->
        <Border Grid.Row="0" Style="{DynamicResource OrdersTopPanelStyle}">
            <DockPanel>

                <!-- Переключение: заказчик / исполнитель / архив -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{DynamicResource OrdersFilterLabelStyle}" Text="Показать:" />
                    <RadioButton
                        Content="Мои заказы (я заказчик)"
                        IsChecked="{Binding IsCustomerView}"
                        Style="{DynamicResource OrdersFilterRadioStyle}" />
                    <RadioButton
                        Content="Мои заказы (я исполнитель)"
                        IsChecked="{Binding IsFreelancerView}"
                        Style="{DynamicResource OrdersFilterRadioStyle}" />
                    <RadioButton
                        Content="Архив"
                        IsChecked="{Binding IsArchiveView}"
                        Style="{DynamicResource OrdersFilterRadioStyle}" />
                </StackPanel>

                <!-- Действия: редактировать / удалить (скрыты в архиве) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Width="180"
                        Margin="5"
                        Content="Изменить статус/дедлайн"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding EditSelectedCommand}"
                        Visibility="{Binding ShowEditActions, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{Binding SelectedRow, Converter={StaticResource NullToFalseConverter}}" />
                    <Button
                        Width="140"
                        Margin="5"
                        Content="Отменить/Удалить"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding DeleteSelectedCommand}"
                        Visibility="{Binding ShowEditActions, Converter={StaticResource BoolToVisibilityConverter}}"
                        IsEnabled="{Binding SelectedRow, Converter={StaticResource NullToFalseConverter}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Список заказов -->
        <ListView
            x:Name="OrdersListView"
            Grid.Row="1"
            ItemsSource="{Binding Orders}"
            SelectedItem="{Binding SelectedRow}"
            SelectionMode="Single"
            Style="{DynamicResource OrdersListViewStyle}">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type data:LocalOrderDisplay}">
                    <Border Style="{DynamicResource OrderCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Заголовок: проект + номер заказа -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,6"
                                Style="{DynamicResource OrderTitleTextStyle}"
                                TextTrimming="CharacterEllipsis">
                                <Run Text="Проект: " />
                                <Run Text="{Binding ProjectTitle, FallbackValue='[Загрузка...]', TargetNullValue='[Проект не найден]'}" />
                                <Run Text=" (Заказ №" />
                                <Run Text="{Binding OrderId}" />
                                <Run Text=")" />
                            </TextBlock>

                            <!-- Статус и дедлайн -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Style="{DynamicResource OrderStatusChipStyle}">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding OrderStatus}" />
                                </Border>
                                <Border Style="{DynamicResource OrderDeadlineChipStyle}">
                                    <TextBlock Foreground="{DynamicResource TextBrush}">
                                        <Run Text="Дедлайн: " />
                                        <Run Text="{Binding OrderDeadline, StringFormat='dd.MM.yyyy', FallbackValue='Не указан', TargetNullValue='Не указан'}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Заказчик / Исполнитель -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,3,0,3">
                                <TextBlock Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Заказчик: " />
                                    <Run Text="{Binding CustomerFullName, FallbackValue='', TargetNullValue='?'}" />
                                </TextBlock>
                                <TextBlock Foreground="{DynamicResource TextBrush}">
                                    <Run Text="Исполнитель: " />
                                    <Run Text="{Binding FreelancerFullName, FallbackValue='', TargetNullValue='?'}" />
                                </TextBlock>
                            </StackPanel>

                            <!-- Дата создания -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Margin="0,4,0,0"
                                Style="{DynamicResource OrderMetaTextStyle}">
                                <Run Text="Создан: " />
                                <Run Text="{Binding OrderCreationDate, StringFormat='dd.MM.yyyy HH:mm'}" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Панель редактирования -->
        <Border
            Grid.Row="2"
            Style="{DynamicResource OrdersEditPanelStyle}"
            Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,15"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="Изменение заказа" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{DynamicResource OrdersEditLabelStyle}"
                        Text="Статус:" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="6,0,0,5"
                        SelectedValuePath="Tag"
                        SelectedValue="{Binding EditStatus}"
                        Style="{DynamicResource OrderEditComboBoxStyle}">
                        <ComboBoxItem Content="Ожидает" Tag="pending" />
                        <ComboBoxItem Content="В работе" Tag="active" />
                        <ComboBoxItem Content="Завершен" Tag="completed" />
                        <ComboBoxItem Content="Отменён" Tag="cancelled" />
                        <ComboBoxItem Content="Спор" Tag="disputed" />
                    </ComboBox>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{DynamicResource OrdersEditLabelStyle}"
                        Text="Дедлайн:" />
                    <DatePicker
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,0,10"
                        SelectedDate="{Binding EditDeadline}"
                        Style="{DynamicResource OrderEditDatePickerStyle}" />
                </Grid>

                <StackPanel Margin="0,15,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button
                        Width="120"
                        Margin="5"
                        Content="Сохранить"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding SaveCommand}" />
                    <Button
                        Width="120"
                        Margin="5"
                        Content="Отмена"
                        Style="{DynamicResource PanelButtonStyle}"
                        Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
