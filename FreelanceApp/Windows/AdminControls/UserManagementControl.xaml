<UserControl
    x:Class="FreelanceApp.Windows.AdminControls.UserManagementControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    xmlns:conv="clr-namespace:FreelanceApp.Converters"
    xmlns:service="clr-namespace:FreelanceApp.Services"
    d:DesignWidth="900"
    d:DesignHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:UserManagementViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- если уже есть в проекте, используйте его; иначе можно временно удалить биндинг IsEnabled -->
        <conv:NullToFalseConverter x:Key="NullToFalse"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <!-- в коде окна/родителя нужно передать currentUser и вызвать InitializeAsync() -->
        <Binding />
    </UserControl.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая колонка -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">

            <!-- Кнопки действий -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Margin="5" Content="Добавить" Command="{Binding AddCommand}"/>
                <Button Margin="5" Content="Редактировать"
                        Command="{Binding EditCommand}"
                        IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToFalse}}"/>
                <Button Margin="5" Content="Удалить"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToFalse}}"/>
            </StackPanel>

            <!-- Форма -->
            <Border Padding="10" Background="#F9F9F9">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ID (только при удалении/редактировании показываем; при добавлении скрыт) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeleteMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="ID пользователя"/>
                            <TextBox Text="{Binding FormId}" IsReadOnly="True"/>
                        </StackPanel>

                        <!-- Поля (для Add/Edit) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeleteMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Margin="0,5,0,0" Text="Last Name"/>
                            <TextBox Text="{Binding LastName}"/>

                            <TextBlock Margin="0,5,0,0" Text="First Name"/>
                            <TextBox Text="{Binding FirstName}"/>

                            <TextBlock Margin="0,5,0,0" Text="Middle Name"/>
                            <TextBox Text="{Binding MiddleName}"/>

                            <TextBlock Margin="0,5,0,0" Text="Gender"/>
                            <ComboBox SelectedValuePath="Content"
                                      SelectedValue="{Binding Gender, Mode=TwoWay}">
                                <ComboBoxItem Content="Male"/>
                                <ComboBoxItem Content="Female"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>

                            <TextBlock Margin="0,5,0,0" Text="Phone Number"/>
                            <TextBox Text="{Binding PhoneNumber}"/>

                            <TextBlock Margin="0,5,0,0" Text="Email"/>
                            <TextBox Text="{Binding Email}"/>

                            <TextBlock Margin="0,5,0,0" Text="Пароль"/>
                            <!-- Привязка Password через поведение -->
                            <PasswordBox
                                service:PasswordBoxHelper.BindPassword="True"
                                service:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Margin="0,5,0,0" Text="Role"/>
                            <ComboBox
                                ItemsSource="{Binding Roles}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding SelectedRoleId}"/>

                            <TextBlock Margin="0,5,0,0" Text="Rating"/>
                            <TextBox Text="{Binding Rating}"/>
                        </StackPanel>

                        <!-- Кнопки Сохранить/Отмена -->
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="80" Margin="5" Content="Сохранить" Command="{Binding SaveCommand}"/>
                            <Button Width="80" Margin="5" Content="Отмена" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Правая колонка: таблица -->
        <DataGrid Grid.Column="1"
                  ItemsSource="{Binding Users}"
                  SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Header="ID" SortMemberPath="Id">
                    <DataGridTextColumn.SortDirection>Ascending</DataGridTextColumn.SortDirection>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding RoleId}" Header="Role ID"/>
                <DataGridTextColumn Binding="{Binding Role.Name}" Header="Role"/>
                <DataGridTextColumn Binding="{Binding FirstName}" Header="First Name"/>
                <DataGridTextColumn Binding="{Binding LastName}" Header="Last Name"/>
                <DataGridTextColumn Binding="{Binding MiddleName}" Header="Middle Name"/>
                <DataGridTextColumn Binding="{Binding Email}" Header="Email"/>
                <!-- По желанию скрыть пароль из таблицы -->
                <!--<DataGridTextColumn Binding="{Binding Password}" Header="Password"/>-->
                <DataGridTextColumn Binding="{Binding Gender}" Header="Gender"/>
                <DataGridTextColumn Binding="{Binding PhoneNumber}" Header="Phone Number"/>
                <DataGridTextColumn Binding="{Binding RegistrationDate}" Header="Registration Date"/>
                <DataGridTextColumn Binding="{Binding LastOnlineTime}" Header="Last Online"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
