<UserControl
    x:Class="FreelanceApp.Windows.AdminControls.UserManagementControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    xmlns:conv="clr-namespace:FreelanceApp.Converters"
    xmlns:service="clr-namespace:FreelanceApp.Services"
    d:DesignWidth="900"
    d:DesignHeight="600"
    d:DataContext="{d:DesignInstance Type=vm:UserManagementViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- если уже есть в проекте, используйте его; иначе можно временно удалить биндинг IsEnabled -->
        <conv:NullToFalseConverter x:Key="NullToFalse"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <!-- в коде окна/родителя нужно передать currentUser и вызвать InitializeAsync() -->
        <Binding />
    </UserControl.DataContext>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: управление и форма (с прокруткой) -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Button Margin="5" Content="{DynamicResource AdminUsers_Button_Add}" Command="{Binding AddCommand}"/>
                <Button Margin="5" Content="{DynamicResource AdminUsers_Button_Edit}"
                        Command="{Binding EditCommand}"
                        IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToFalse}}"/>
                <Button Margin="5" Content="{DynamicResource AdminUsers_Button_Delete}"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToFalse}}"/>
            </StackPanel>

            <!-- Форма редактирования / создания пользователя -->
            <Border Grid.Row="1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource BorderStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFormOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!-- Прокрутка только по вертикали для формы -->
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- ID (только при удалении/редактировании показываем; при добавлении скрыт) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeleteMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Margin="10,0,10,2" Text="{DynamicResource AdminUsers_Label_UserId}" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Text="{Binding FormId}" IsReadOnly="True"/>
                        </StackPanel>

                        <!-- Поля (для Add/Edit) -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDeleteMode}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Margin="10,5,10,0" Text="Last Name" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Text="{Binding LastName}" />

                            <TextBlock Margin="10,5,10,0" Text="First Name" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Text="{Binding FirstName}"/>

                            <TextBlock Margin="10,5,10,0" Text="Middle Name" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Text="{Binding MiddleName}"/>

                            <TextBlock Margin="10,5,10,0" Text="Gender" Foreground="{DynamicResource TextBrush}"/>
                            <ComboBox
                                Style="{DynamicResource ProfileComboBoxStyle}"
                                SelectedValuePath="Content"
                                SelectedValue="{Binding Gender, Mode=TwoWay}">
                                <ComboBoxItem Content="Male"/>
                                <ComboBoxItem Content="Female"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>

                            <TextBlock Margin="10,5,10,0" Text="Phone Number" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Text="{Binding PhoneNumber}"/>

                            <TextBlock Margin="10,5,10,0" Text="Email" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Text="{Binding Email}"/>

                            <TextBlock Margin="10,5,10,0" Text="{DynamicResource AdminUsers_Label_Password}" Foreground="{DynamicResource TextBrush}"/>
                            <!-- Привязка Password через поведение -->
                            <PasswordBox
                                Style="{DynamicResource ProfilePasswordBoxStyle}"
                                service:PasswordBoxHelper.BindPassword="True"
                                service:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Margin="10,5,10,0" Text="Role" Foreground="{DynamicResource TextBrush}"/>
                            <ComboBox
                                Style="{DynamicResource ProfileComboBoxStyle}"
                                ItemsSource="{Binding Roles}"
                                DisplayMemberPath="Name"
                                SelectedValuePath="Id"
                                SelectedValue="{Binding SelectedRoleId}"/>

                            <TextBlock Margin="10,5,10,0" Text="Rating" Foreground="{DynamicResource TextBrush}"/>
                            <TextBox Text="{Binding Rating}"/>
                        </StackPanel>

                        <!-- Кнопки Сохранить/Отмена -->
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Width="80" Margin="5" Content="{DynamicResource AdminUsers_Button_Save}" Command="{Binding SaveCommand}"/>
                            <Button Width="80" Margin="5" Content="{DynamicResource AdminUsers_Button_Cancel}" Command="{Binding CancelCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Правая колонка: кастомный список пользователей -->
        <ScrollViewer
            Grid.Column="1"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <ListView
                ItemsSource="{Binding Users}"
                SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                Background="Transparent"
                BorderThickness="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#08000000" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#12000000" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Фото пользователя -->
                                <Image Grid.Row="0" Grid.RowSpan="4" Grid.Column="0" Margin="0,0,10,0">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Width" Value="64" />
                                            <Setter Property="Height" Value="64" />
                                            <Setter Property="Stretch" Value="UniformToFill" />
                                            <Setter Property="Source"
                                                    Value="{Binding Photo, Converter={StaticResource BytesToImageConverter}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Photo}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <!-- Основная информация -->
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock
                                        FontWeight="Bold"
                                        FontSize="14"
                                        Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{Binding LastName}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding FirstName}" />
                                        <Run Text=" " />
                                        <Run Text="{Binding MiddleName}" />
                                    </TextBlock>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="Email: " />
                                        <Run Text="{Binding Email}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Роль и рейтинг -->
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="8"
                                        Padding="6,2"
                                        Margin="0,0,6,0">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SecondaryBrush}"
                                            Text="{Binding Role.Name}" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{DynamicResource AdminUsers_Card_RatingPrefix}" />
                                        <Run Text="{Binding Rating}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Дополнительные данные -->
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{DynamicResource AdminUsers_Card_GenderPrefix}" />
                                        <Run Text="{Binding Gender}" />
                                    </TextBlock>
                                    <TextBlock
                                        Margin="16,0,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{DynamicResource AdminUsers_Card_PhonePrefix}" />
                                        <Run Text="{Binding PhoneNumber}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{DynamicResource AdminUsers_Card_RegisteredPrefix}" />
                                        <Run Text="{Binding RegistrationDate, StringFormat='dd.MM.yyyy'}" />
                                    </TextBlock>
                                    <TextBlock
                                        Margin="16,0,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{DynamicResource AdminUsers_Card_LastOnlinePrefix}" />
                                        <Run Text="{Binding LastOnlineTime, StringFormat='dd.MM.yyyy HH:mm', TargetNullValue='—'}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollViewer>
    </Grid>
</UserControl>
