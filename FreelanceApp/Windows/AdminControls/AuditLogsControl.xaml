<UserControl
    x:Class="FreelanceApp.Windows.AdminControls.AuditLogsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:FreelanceApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:AuditLogsViewModel}">

    <UserControl.Resources>
        <converters:SubstringConverter x:Key="Sub50" MaxLength="50" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: фильтр и действия -->
        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Margin="0,0,0,10" FontWeight="Bold" Text="Фильтр по дате"/>

            <TextBlock Text="С (since):"/>
            <DatePicker SelectedDate="{Binding Since, Mode=TwoWay}"/>

            <TextBlock Margin="0,5,0,0" Text="По (until):"/>
            <DatePicker SelectedDate="{Binding Until, Mode=TwoWay}"/>

            <Button Margin="0,10,0,0" Content="Загрузить" Command="{Binding LoadCommand}"/>

            <Separator Margin="0,20"/>

            <TextBlock Margin="0,0,0,10" FontWeight="Bold" Text="Экспорт/Импорт"/>
            <Button Margin="0,0,5,5" Content="Экспорт в JSON" Command="{Binding ExportCommand}"/>
            <Button Content="Импорт из JSON" Command="{Binding ImportCommand}"/>

            <!-- индикатор -->
            <TextBlock Margin="0,12,0,0"
                       Foreground="Gray"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                       Text="Загрузка..."/>
        </StackPanel>

        <!-- Правая часть: таблица логов -->
        <DataGrid Grid.Column="1"
                  ItemsSource="{Binding Logs}"
                  Margin="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50"  Binding="{Binding Id}"         Header="Id"/>
                <DataGridTextColumn Width="150" Binding="{Binding ProcName}"   Header="Procedure"/>
                <DataGridTextColumn Width="80"  Binding="{Binding UserId}"     Header="UserId"/>
                <DataGridTextColumn Width="100" Binding="{Binding Action}"     Header="Action"/>
                <DataGridTextColumn Width="100" Binding="{Binding TableName}"  Header="Table"/>
                <DataGridTextColumn Width="80"  Binding="{Binding RecordId}"   Header="RecordId"/>
                <DataGridTextColumn Width="200" Binding="{Binding OldData, Converter={StaticResource Sub50}}" Header="OldData"/>
                <DataGridTextColumn Width="200" Binding="{Binding NewData, Converter={StaticResource Sub50}}" Header="NewData"/>
                <DataGridTextColumn Width="140" Binding="{Binding ChangedAt}"  Header="ChangedAt"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
