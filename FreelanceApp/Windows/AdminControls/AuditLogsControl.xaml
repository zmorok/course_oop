<UserControl
    x:Class="FreelanceApp.Windows.AdminControls.AuditLogsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:FreelanceApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:AuditLogsViewModel}">

    <UserControl.Resources>
        <converters:SubstringConverter x:Key="Sub50" MaxLength="50" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: фильтр и действия -->
        <Border Grid.Column="0">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,10"
                    Style="{DynamicResource PanelHeaderStyle}"
                    Text="Фильтр по дате" />

                <TextBlock
                    Margin="10,0,10,2"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="С (since):" />
                <DatePicker
                    Margin="10,0,10,6"
                    SelectedDate="{Binding Since, Mode=TwoWay}"
                    Background="{DynamicResource CardBrush}"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextBrush}" />
                   

                <TextBlock
                    Margin="10,6,10,2"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Text="По (until):" />
                <DatePicker
                    Margin="10,0,10,6"
                    SelectedDate="{Binding Until, Mode=TwoWay}"
                    Background="{DynamicResource CardBrush}"
                    BorderThickness="0"
                    Foreground="{DynamicResource TextBrush}" />

                <Button
                    Margin="10,10,10,0"
                    Content="Загрузить"
                    Command="{Binding LoadCommand}" />

                <Separator Margin="10,20,10,10" />

                <TextBlock
                    Margin="10,0,10,6"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextBrush}"
                    Text="Экспорт/Импорт" />
                <Button
                    Margin="10,0,10,5"
                    Content="Экспорт в JSON"
                    Command="{Binding ExportCommand}" />
                <Button
                    Margin="10,0,10,0"
                    Content="Импорт из JSON"
                    Command="{Binding ImportCommand}" />

                <!-- индикатор -->
                <TextBlock
                    Margin="10,12,10,0"
                    Foreground="{DynamicResource MutedTextBrush}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    Text="Загрузка..." />
            </StackPanel>
        </Border>

        <!-- Правая часть: таблица логов -->
        <DataGrid Grid.Column="1"
                  ItemsSource="{Binding Logs}"
                  Margin="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource CardBrush}"
                  AlternatingRowBackground="#05000000"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource CardBorderBrush}"
                  HeadersVisibility="Column">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Width="50"
                                    Binding="{Binding Id}"
                                    Header="Id"
                                    SortMemberPath="Id">
                    <DataGridTextColumn.SortDirection>Ascending</DataGridTextColumn.SortDirection>
                </DataGridTextColumn>
                <DataGridTextColumn Width="150" Binding="{Binding ProcName}"   Header="Procedure"/>
                <DataGridTextColumn Width="80"  Binding="{Binding UserId}"     Header="UserId"/>
                <DataGridTextColumn Width="100" Binding="{Binding Action}"     Header="Action"/>
                <DataGridTextColumn Width="100" Binding="{Binding TableName}"  Header="Table"/>
                <DataGridTextColumn Width="80"  Binding="{Binding RecordId}"   Header="RecordId"/>
                <DataGridTextColumn Width="200" Binding="{Binding OldData, Converter={StaticResource Sub50}}" Header="OldData"/>
                <DataGridTextColumn Width="200" Binding="{Binding NewData, Converter={StaticResource Sub50}}" Header="NewData"/>
                <DataGridTextColumn Width="140" Binding="{Binding ChangedAt}"  Header="ChangedAt"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
