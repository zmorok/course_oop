<UserControl x:Class="FreelanceApp.Windows.AdminControls.ComplaintsModerationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FreelanceApp.Windows.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:ComplaintsModerationViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Bool2Vis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Фильтры -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource AdminComplaints_Filter_StatusLabel}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextBrush}"/>
            <ComboBox Width="170" Margin="0,0,8,0"
                      ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      Style="{DynamicResource ProfileComboBoxStyle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- по умолчанию показываем код, чтобы не было пусто -->
                                    <Setter Property="Text" Value="{Binding Code}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Code}" Value="new">
                                            <Setter Property="Text"
                                                    Value="{DynamicResource AdminComplaints_Filter_Status_New}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Code}" Value="in_progress">
                                            <Setter Property="Text"
                                                    Value="{DynamicResource AdminComplaints_Filter_Status_InProgress}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Code}" Value="resolved">
                                            <Setter Property="Text"
                                                    Value="{DynamicResource AdminComplaints_Filter_Status_Resolved}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Code}" Value="dismissed">
                                            <Setter Property="Text"
                                                    Value="{DynamicResource AdminComplaints_Filter_Status_Dismissed}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Code}" Value="all">
                                            <Setter Property="Text"
                                                    Value="{DynamicResource AdminComplaints_Filter_Status_All}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBox Width="240" Margin="8,0,0,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding RefreshCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="{DynamicResource AdminComplaints_Button_Find}" Margin="6,0,0,0" Command="{Binding RefreshCommand}"/>
            <Button Content="{DynamicResource AdminComplaints_Button_Refresh}" Margin="6,0,0,0" Command="{Binding RefreshCommand}"/>
        </StackPanel>

        <!-- Список жалоб -->
        <GroupBox Grid.Row="1" Grid.Column="0" Header="{DynamicResource AdminComplaints_Group_Complaints}" Foreground="{DynamicResource TextBrush}">
            <ListView ItemsSource="{Binding Complaints}"
                      SelectedItem="{Binding SelectedComplaint}"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource ComplaintListItemCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">
                                        <Run Text="{DynamicResource AdminComplaints_Row_FromPrefix}"/><Run Text="{Binding FiledByName}"/>
                                        <Run Text="{DynamicResource AdminComplaints_Row_ToPrefix}"/><Run Text="{Binding UserComName}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                        <Run Text="{DynamicResource AdminComplaints_Row_StatusPrefix}"/><Run Text="{Binding Status}"/>
                                        <Run Text="  •  №"/><Run Text="{Binding Id_Complaint}"/>
                                        <Run Text="{DynamicResource AdminComplaints_Row_OrderPrefix}"/>
                                        <Run Text="{Binding Id_Order, TargetNullValue=—}"/>
                                        <Run Text="{DynamicResource AdminComplaints_Row_ArchivePrefix}"/>
                                        <Run Text="{Binding Id_Order_Arc, TargetNullValue=—}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,4,0,0"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextBrush}"/>

                                    <!-- Превью медиа, если есть -->
                                    <Image>
                                        <Image.Style>
                                            <Style TargetType="Image" BasedOn="{StaticResource ComplaintThumbnailImageStyle}">
                                                <Setter Property="Source"
                                                        Value="{Binding Media, Converter={StaticResource MediaToImageConverter}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Media, Converter={StaticResource MediaToImageConverter}}"
                                                                 Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </StackPanel>

                                <!-- Убираем CreatedAt — его нет в вашей вьюхе -->
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <!-- Разделитель -->
        <Grid Grid.Row="1" Grid.Column="1"/>

        <!-- Детали + действия -->
        <GroupBox Grid.Row="1" Grid.Column="2" Header="{DynamicResource AdminComplaints_Group_Details}" Foreground="{DynamicResource TextBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{DynamicResource ComplaintsEditBorderStyle}">
                    <StackPanel>
                        <TextBlock FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"
                                   Text="{Binding SelectedComplaint.Id_Complaint, StringFormat={StaticResource AdminComplaints_Details_ComplaintNo}}"/>
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextBrush}">
                            <Run Text="{DynamicResource AdminComplaints_Details_FromPrefix}"/><Run Text="{Binding SelectedComplaint.FiledByName, TargetNullValue=—}"/>
                            <Run Text="{DynamicResource AdminComplaints_Details_ToPrefix}"/><Run Text="{Binding SelectedComplaint.UserComName, TargetNullValue=—}"/>
                        </TextBlock>

                        <StackPanel 
                            Orientation="Horizontal"
                            Margin="0,6,0,0">
                            <TextBlock VerticalAlignment="Center"
                                       Text="{DynamicResource AdminComplaints_Details_StatusLabel}"
                                       Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextBrush}" />
                            <ComboBox Width="180"
                                      Margin="5"
                                      ItemsSource="{Binding StatusEditOptions}"
                                      SelectedValuePath="Code"
                                      SelectedValue="{Binding StatusEdit, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      Style="{DynamicResource ProfileComboBoxStyle}"
                                      IsEnabled="{Binding SelectedComplaint, Converter={StaticResource Bool2Vis}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Code}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Code}" Value="new">
                                                            <Setter Property="Text"
                                                                    Value="{DynamicResource AdminComplaints_Status_New}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Code}" Value="in_progress">
                                                            <Setter Property="Text"
                                                                    Value="{DynamicResource AdminComplaints_Status_InProgress}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Code}" Value="dismissed">
                                                            <Setter Property="Text"
                                                                    Value="{DynamicResource AdminComplaints_Status_Dismissed}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{DynamicResource AdminComplaints_Button_SaveStatus}" Margin="6,0,0,0"
                                    Command="{Binding SaveStatusCommand}"
                                    IsEnabled="{Binding SelectedComplaint, Converter={StaticResource Bool2Vis}}"/>
                            <Button Content="{DynamicResource AdminComplaints_Button_TakeInWork}" Margin="6,0,0,0"
                                    Command="{Binding TakeInWorkCommand}"
                                    IsEnabled="{Binding SelectedComplaint, Converter={StaticResource Bool2Vis}}"/>
                        </StackPanel>

                        <TextBlock Margin="0,8,0,2" Text="{DynamicResource AdminComplaints_Details_ComplaintText}"
                                   Style="{DynamicResource ComplaintsLabelTextStyle}"/>
                        <TextBox Height="90" TextWrapping="Wrap" IsReadOnly="True"
                                 Text="{Binding SelectedComplaint.Description}"/>

                        <TextBlock Margin="0,8,0,2" Text="{DynamicResource AdminComplaints_Details_MediaJson}"
                                   Style="{DynamicResource ComplaintsLabelTextStyle}"/>
                        
                        <!-- Превью медиа для выбранной жалобы -->
                        <Image>
                            <Image.Style>
                                <Style TargetType="Image" BasedOn="{StaticResource ComplaintsEditImageStyle}">
                                    <Setter Property="Source"
                                            Value="{Binding SelectedComplaint.Media, Converter={StaticResource MediaToImageConverter}}"/>
                                            <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedComplaint.Media, Converter={StaticResource MediaToImageConverter}}"
                                     Value="{x:Null}">      
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Separator Margin="0,10"/>

                        <TextBlock FontWeight="Bold" Text="{DynamicResource AdminComplaints_Warning_Header}"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox Height="60" TextWrapping="Wrap"
                                 Text="{Binding WarningText}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="{DynamicResource AdminComplaints_Button_IssueWarning}"
                                    Command="{Binding IssueWarningCommand}"
                                    IsEnabled="{Binding SelectedComplaint, Converter={StaticResource Bool2Vis}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </GroupBox>

        <!-- Нижняя панель: быстрые действия -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource AdminComplaints_Footer_Reject}" Margin="6,0,0,0"
                    Command="{Binding DismissCommand}"
                    IsEnabled="{Binding SelectedComplaint, Converter={StaticResource Bool2Vis}}"/>
            <Button Content="{DynamicResource AdminComplaints_Footer_Close}" Margin="6,0,0,0"
                    Command="{Binding ResolveCommand}"
                    IsEnabled="{Binding SelectedComplaint, Converter={StaticResource Bool2Vis}}"/>
        </StackPanel>
    </Grid>
</UserControl>
