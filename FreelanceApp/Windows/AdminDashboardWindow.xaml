<Window
    x:Class="FreelanceApp.Windows.AdminDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Панель администратора"
    Width="1000"
    Height="650"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Верхняя панель  -->
        <Border Grid.Row="0" Style="{DynamicResource TopPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{DynamicResource WelcomeTextStyle}"
                        Text="Администрирование" />
                    <TextBlock
                        Margin="2,2,0,0"
                        Foreground="{DynamicResource SecondaryBrush}"
                        FontSize="13"
                        Text="Контроль пользователей, ролей и жалоб" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{DynamicResource SecondaryBrush}"
                        Text="{DynamicResource CurrentTheme}" />
                    <Button
                        x:Name="AdminLightThemeButton"
                        Style="{DynamicResource ThemeToggleButtonStyle}"
                        Click="LightThemeButton_Click"
                        Content="☀"
                        ToolTip="Светлая тема" />
                    <Button
                        x:Name="AdminDarkThemeButton"
                        Style="{DynamicResource ThemeToggleButtonStyle}"
                        Click="DarkThemeButton_Click"
                        Content="🌙"
                        Margin="0"
                        ToolTip="Тёмная тема" />
                    <Button
                        Width="130"
                        Margin="10,0,0,0"
                        Click="Logout_Click"
                        Content="Выйти"
                        Style="{DynamicResource LogoutButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Основная сетка  -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Style="{DynamicResource SideMenuStyle}">
                <StackPanel Cursor="">
                    <TextBlock
                        Margin="12,16,12,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SecondaryBrush}"
                        Text="Навигация" />
                    <Button
                        Margin="0,2"
                        Click="ShowUsers_Click"
                        Content="Пользователи"
                        Style="{DynamicResource MenuButtonStyle}" />
                    <Button
                        Margin="0,2"
                        Click="ShowAudit_Click"
                        Content="Аудит"
                        Style="{DynamicResource MenuButtonStyle}" />
                    <Button
                        Margin="0,2"
                        Click="ShowComplaints_Click"
                        Content="Жалобы"
                        Style="{DynamicResource MenuButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Style="{DynamicResource MainContentBorderStyle}">
                <ContentControl x:Name="MainContent" Style="{DynamicResource MainContentStyle}" />
            </Border>
        </Grid>
    </Grid>
</Window>
