<Window
    x:Class="FreelanceApp.Windows.AdminDashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{DynamicResource AdminDashboard_Title}"
    Width="1000"
    Height="650"
    MinWidth="900"
    MinHeight="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Верхняя панель  -->
        <Border Grid.Row="0" Style="{DynamicResource TopPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        HorizontalAlignment="Left"
                        Style="{DynamicResource WelcomeTextStyle}"
                        Text="{DynamicResource AdminDashboard_Header_Title}" />
                    <TextBlock
                        Margin="2,2,0,0"
                        Foreground="{DynamicResource SecondaryBrush}"
                        FontSize="13"
                        Text="{DynamicResource AdminDashboard_Header_Subtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="18"
                        Foreground="{DynamicResource SecondaryBrush}"
                        Text="{DynamicResource CurrentTheme}" />
                    <Button
                        x:Name="AdminLightThemeButton"
                        Style="{DynamicResource ThemeToggleButtonStyle}"
                        Click="LightThemeButton_Click"
                        Content="☀"
                        ToolTip="{DynamicResource TopBar_Theme_Light_Tooltip}" />
                    <Button
                        x:Name="AdminDarkThemeButton"
                        Style="{DynamicResource ThemeToggleButtonStyle}"
                        Click="DarkThemeButton_Click"
                        Content="🌙"
                        Margin="0"
                        ToolTip="{DynamicResource TopBar_Theme_Dark_Tooltip}" />
                    <Button
                        x:Name="RuLangButton"
                        Width="36"
                        Margin="10,0,0,0"
                        Style="{DynamicResource ThemeToggleButtonStyle}"
                        Click="SetRu_Click"
                        Content="RU"
                        ToolTip="{DynamicResource TopBar_Language_Ru_Tooltip}" />
                    <Button
                        x:Name="EnLangButton"
                        Width="36"
                        Margin="4,0,0,0"
                        Style="{DynamicResource ThemeToggleButtonStyle}"
                        Click="SetEn_Click"
                        Content="EN"
                        ToolTip="{DynamicResource TopBar_Language_En_Tooltip}" />
                    <Button
                        Width="130"
                        Margin="10,0,0,0"
                        Click="Logout_Click"
                        Content="{DynamicResource Common_Logout}"
                        Style="{DynamicResource LogoutButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Основная сетка  -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Style="{DynamicResource SideMenuStyle}">
                <StackPanel Cursor="">
                    <TextBlock
                        Margin="12,16,12,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextBrush}"
                        Text="{DynamicResource AdminDashboard_Navigation_Header}" />
                    <Button
                        Margin="0,2"
                        Click="ShowUsers_Click"
                        Content="{DynamicResource AdminDashboard_Navigation_Users}"
                        Style="{DynamicResource MenuButtonStyle}" />
                    <Button
                        Margin="0,2"
                        Click="ShowAudit_Click"
                        Content="{DynamicResource AdminDashboard_Navigation_Audit}"
                        Style="{DynamicResource MenuButtonStyle}" />
                    <Button
                        Margin="0,2"
                        Click="ShowComplaints_Click"
                        Content="{DynamicResource AdminDashboard_Navigation_Complaints}"
                        Style="{DynamicResource MenuButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border Grid.Column="1" Style="{DynamicResource MainContentBorderStyle}">
                <ContentControl x:Name="MainContent" Style="{DynamicResource MainContentStyle}" />
            </Border>
        </Grid>
    </Grid>
</Window>
